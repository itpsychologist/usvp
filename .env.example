# Скопіюйте у .env і змініть значення. .env не комітиться.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose up -d db). Якщо закоментувати — буде SQLite.
DATABASE_URL=postgres://usvp:usvp@localhost:5432/usvp

# Шляхи адмінок (у продакшні змінити на неочевидні)
WAGTAIL_ADMIN_PATH=cms-admin/
DJANGO_ADMIN_PATH=django-admin/
WAGTAILADMIN_BASE_URL=http://localhost:8000

# UI-кіт і wireframes на /styleguide/ (у dev увімкнено за замовчуванням; у prod завжди вимкнено)
# STYLEGUIDE_ENABLED=True
# Версія standalone-бінарника Tailwind для manage.py tailwind build
# TAILWIND_CLI_VERSION=4.3.3

# Лише для prod
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.gov.ua
# DJANGO_SECURE_SSL_REDIRECT=True
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# DEFAULT_FROM_EMAIL=noreply@example.gov.ua
